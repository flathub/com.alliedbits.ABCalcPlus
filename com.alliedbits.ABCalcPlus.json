        {
          "type": "archive",
          "url": "https://alliedbits.com/files/abcalc-1.6.1-linux-aarch64.tar.gz",
          "sha256": "4ed4d17ff6ceabc8ca79e1f029695e1be264d69d40d51420ac443aa9922b8657",
